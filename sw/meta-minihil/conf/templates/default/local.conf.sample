# Local configuration for Yocto MiniHIL Build
# Pinned to Yocto 5.0 LTS (Scarthgap)

# Default Machine: Raspberry Pi 3B+ (64-bit)
MACHINE ??= "raspberrypi3-64"

# Default Distro
DISTRO ?= "poky"

# Default Package Management format
PACKAGE_CLASSES ?= "package_ipk"

# Extra Image Features
# - debug-tweaks: Allows root login without a password
EXTRA_IMAGE_FEATURES ?= "debug-tweaks"

# User Classes (build statistics logging)
USER_CLASSES ?= "buildstats"

# Stop builds when disk space runs low
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

# Keep temporary files after build? 
# Uncomment the line below to delete build directories of completed recipes.
# This saves significant disk space, but disables rebuilding without refetching/re-unpacking.
# INHERIT += "rm_work"

# Caching locations (Uncomment and customize if using a shared build cache across projects)
# DL_DIR ?= "${TOPDIR}/downloads"
# SSTATE_DIR ?= "${TOPDIR}/sstate-cache"

# Configuration Version (DO NOT EDIT)
CONF_VERSION = "2"
